{
  "name": "@dog-tracker/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "npm run copy-worker && next dev -p 3000",
    "build": "npm run copy-worker && next build",
    "start": "next start -p 3000",
    "typecheck": "tsc --noEmit",
    "copy-worker": "mkdir -p public && cp ../../node_modules/maplibre-gl/dist/maplibre-gl-worker.mjs public/maplibre-gl-worker.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "maplibre-gl": "^6.13.0",
    "next": "^16.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vitest": "^5.0.3"
  }
}
